{
    "configurations": [
        {
            "type": "node",
            "name": "UI (mock)",
            "request": "launch",
            "cwd": "${workspaceFolder}/ui",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev:mock"],
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "java",
            "name": "Spring Boot-BackendApplication<proxima-sal-backend>",
            "request": "launch",
            "cwd": "${workspaceFolder}/backend",
            "mainClass": "com.etactics.proxima.sal.backend.BackendApplication",
            "projectName": "proxima-sal-backend",
            "args": "",
            "vmArgs": "-Dspring.profiles.active=dev",
            "envFile": "${workspaceFolder}/backend/.env"
        }
    ]
}