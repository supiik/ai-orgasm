# App database
APP_DB_NAME=orgasm
APP_DB_USER=orgasm
APP_DB_PASSWORD=orgasm
APP_DB_ROOT_PASSWORD=orgasm_root

# Billing database
BILLING_DB_NAME=orgasm_billing
BILLING_DB_USER=orgasm_billing
BILLING_DB_PASSWORD=orgasm_billing
BILLING_DB_ROOT_PASSWORD=orgasm_billing_root

# Mail (Mailpit on localhost:1025 for local dev; override for SMTP relay / SES in production)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@orgasm.local

# Spotify OAuth (playlist export) — register an app at https://developer.spotify.com/dashboard
# with redirect URI http://localhost:5173/spotify/callback for local dev
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/spotify/callback
SPOTIFY_STATE_SECRET=
