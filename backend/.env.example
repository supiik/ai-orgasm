# App database
APP_DB_NAME=proxima_service
APP_DB_USER=proxima_service
APP_DB_PASSWORD=proxima_service
APP_DB_ROOT_PASSWORD=proxima_service_root

# Billing database
BILLING_DB_NAME=proxima_service_billing
BILLING_DB_USER=proxima_service_billing
BILLING_DB_PASSWORD=proxima_service_billing
BILLING_DB_ROOT_PASSWORD=proxima_service_billing_root

# Mail (Mailpit on localhost:1025 for local dev; override for SMTP relay / SES in production)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=noreply@proxima-service.local
