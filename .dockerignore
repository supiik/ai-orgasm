# Version control
.git/
.gitignore

# Build outputs
target/
*/target/
**/target/

# Frontend (not needed for lambda Docker build) — pom.xml itself stays included: the
# lambda Dockerfile's multi-stage build needs every reactor module's pom.xml present for
# Maven to resolve the root POM's <modules> list, even though only backend-dynamo/lambda
# actually get their src/ copied and built.
ui/
!ui/pom.xml
ui/node_modules/

# IDE / editor
.idea/
*.iml
.vscode/
*.code-workspace

# Local env / secrets
backend/.env
**/.env

# Maven wrapper cache
.mvn/repository/

# Test reports and coverage
**/surefire-reports/
**/failsafe-reports/
**/site/

# Logs
*.log
