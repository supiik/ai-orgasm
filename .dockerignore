# Version control
.git/
.gitignore

# Build outputs — except the shaded fat jar the lambda Dockerfile packages (built by Maven
# outside Docker; see lambda/Dockerfile's header comment).
target/
*/target/
**/target/
!lambda/target/orgasm-lambda-*.jar

# Frontend (not needed for lambda Docker build)
ui/
ui/node_modules/

# IDE / editor
.idea/
*.iml
.vscode/
*.code-workspace

# Local env / secrets
backend/.env
**/.env

# Maven wrapper cache
.mvn/repository/

# Test reports and coverage
**/surefire-reports/
**/failsafe-reports/
**/site/

# Logs
*.log
